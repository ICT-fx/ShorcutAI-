# =============================================================================
# Auto Video Editor — environment configuration
# Copy to `.env` and fill in. EVERYTHING defaults to the free / self-hosted path.
# Paid services are OFF unless you explicitly turn them on.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# SQLite (default, free, zero-infra) OR Supabase Postgres (see below).
DATABASE_URL="file:./dev.db"
# Public base URL of the Next app. The Remotion renderer (headless Chrome) uses
# this to fetch media over HTTP during render, so it must be reachable.
APP_BASE_URL="http://localhost:3000"

# --- Supabase (Postgres + Storage + Auth) -------------------------------------
# Fill these to switch off SQLite/local-FS. From the Supabase dashboard:
#   Connect → ORM → Prisma  gives DATABASE_URL (pooler 6543) + DIRECT_URL (5432).
# When using Supabase Postgres, set DATABASE_URL above to the POOLER url and add:
DIRECT_URL=""
# Project API (Settings → API). NEXT_PUBLIC_* are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# service_role key — SERVER ONLY, never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Storage ------------------------------------------------------------------
# local | r2 | supabase
STORAGE_DRIVER="local"
# Root folder for the local filesystem adapter.
STORAGE_LOCAL_ROOT="./storage"
# --- Supabase Storage (only if STORAGE_DRIVER=supabase) ---
# Uses the values in the Supabase section below + this bucket name.
# The bucket must be PUBLIC (renderer + browser fetch objects by URL).
SUPABASE_BUCKET="media"
# --- (only needed if STORAGE_DRIVER=r2) ---
# R2 / S3-compatible. Backblaze B2 also works with the S3 endpoint.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Job queue (BullMQ / Redis) ----------------------------------------------
# Redis is required for the async transcription + render jobs.
# Free locally: `brew install redis && redis-server`
REDIS_URL="redis://127.0.0.1:6379"

# --- Transcription ------------------------------------------------------------
# faster-whisper (self-host, free) is the default. groq is a paid fallback.
# Order is comma-separated; the first reachable provider wins.
TRANSCRIBE_PROVIDERS="faster-whisper,groq"
# Self-hosted faster-whisper microservice (see services/transcription).
WHISPER_SERVICE_URL="http://127.0.0.1:8001"
# Groq Whisper fallback (~$0.02–0.04 / audio hour). Leave empty to disable.
GROQ_API_KEY=""
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# --- LLM editorial layer (Anthropic) -----------------------------------------
# Used ONLY in Phase 3+. If empty, the app falls back to the deterministic
# rule-based editor and never calls the API. Never hardcode this key.
ANTHROPIC_API_KEY=""
# Economical model for the EDL decision task.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
# Hard cap on LLM repair attempts when the EDL fails validation.
LLM_MAX_REPAIR_ATTEMPTS="2"

# --- Remotion license ---------------------------------------------------------
# LEAVE EMPTY for personal / ≤3-person internal use (free).
# Required (Remotion for Automators, $0.01/render, min $100/mo) once you serve
# rendered videos to end users as a commercial product. See README.
REMOTION_LICENSE_KEY=""

# --- Cost / safety guardrails -------------------------------------------------
# Reject uploads larger than this (per file), in megabytes.
MAX_UPLOAD_MB="500"
# Reject source rushes longer than this (seconds). 0 = no limit.
MAX_CLIP_SECONDS="1800"
# Max total render duration we'll enqueue (seconds). Protects render cost.
MAX_RENDER_SECONDS="600"
